<Window x:Class="InnerTune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="InnerTune" Width="1280" Height="800" MinWidth="1040" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#0B0B0E"
        Icon="Assets/InnerTune-DJCat.png"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Text,Segoe UI"
        Closing="Window_Closing" PreviewTextInput="Window_PreviewTextInput">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/>
  </shell:WindowChrome.WindowChrome>
  <Border Background="#0B0B0E" BorderBrush="#28272F" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="TitleRow" Height="58"/>
        <RowDefinition x:Name="BodyRow" Height="*"/>
        <RowDefinition Height="96"/>
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Grid.Row="0" Background="#0D0D10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
          <Border Width="34" Height="34" CornerRadius="10" Background="#201A2C" Padding="2"><Image Source="Assets/InnerTune-DJCat.png" Stretch="Uniform"/></Border>
          <TextBlock Text="InnerTune" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border x:Name="StatusPill" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#25242C" CornerRadius="15" Padding="13,6">
          <TextBlock x:Name="StatusText" Foreground="#D8D5DF" FontSize="11"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
          <Button x:Name="TopmostButton" Style="{StaticResource IconButton}" Content="&#xE718;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" ToolTip="Keep window on top" Click="Topmost_Click"/>
          <Button Style="{StaticResource IconButton}" Content="—" ToolTip="Minimize" Click="Minimize_Click"/>
          <Button Style="{StaticResource IconButton}" Content="×" ToolTip="Hide to tray" Click="Hide_Click"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="Body" Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/><ColumnDefinition Width="336"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#101014" BorderBrush="#242329" BorderThickness="0,0,1,0" Padding="14,22,14,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="EXPLORE" FontSize="10" Foreground="#696771" Margin="16,0,0,10" FontWeight="Bold"/>
              <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Content="Home" Click="HomeNav_Click"/>
              <Button x:Name="SearchNav" Style="{StaticResource NavButton}" Content="Search" Click="SearchNav_Click"/>
              <Button x:Name="AiNav" Style="{StaticResource NavButton}" Content="Ask Luna" Click="AiNav_Click"/>
              <TextBlock Text="YOUR LIBRARY" FontSize="10" Foreground="#696771" Margin="16,24,0,10" FontWeight="Bold"/>
              <Button x:Name="FavoritesNav" Style="{StaticResource NavButton}" Content="Liked songs" Click="FavoritesNav_Click"/>
              <Button x:Name="SavedNav" Style="{StaticResource NavButton}" Content="Saved queues" Click="SavedNav_Click"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1">
          <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#211B33"/><GradientStop Color="#111115" Offset="0.32"/><GradientStop Color="#101014" Offset="1"/></LinearGradientBrush></Grid.Background>
          <Grid Margin="34,28,34,22">
            <Grid x:Name="HomePanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="HomeBackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Back to Home" Click="HomeBack_Click"/>
                  <StackPanel>
                    <TextBlock x:Name="HomeGreeting" Text="Good evening" FontSize="32" FontWeight="Bold"/>
                    <TextBlock x:Name="HomeTagline" Text="Fresh music, familiar favorites, and something for right now." Foreground="{StaticResource TextMuted}" Margin="1,7,0,0"/>
                  </StackPanel>
                </StackPanel>
                <Button x:Name="RefreshHomeButton" Style="{StaticResource IconButton}" Content="&#xE72C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Refresh Home" Click="RefreshHome_Click"/>
              </Grid>

              <Grid Grid.Row="1" Margin="0,22,0,0">
                <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="0,0,5,18">
                    <Border x:Name="ContinueCard" CornerRadius="18" Padding="16" Margin="0,0,0,22" Visibility="Collapsed" BorderBrush="#403552" BorderThickness="1">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#33264D"/><GradientStop Color="#19171F" Offset="1"/></LinearGradientBrush></Border.Background>
                      <Grid Height="96">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="88" Height="88" CornerRadius="12" Background="#292830"><Image x:Name="ContinueArtwork" Stretch="UniformToFill"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,14,0">
                          <TextBlock Text="CONTINUE LISTENING" Foreground="#BCA8EF" FontSize="9" FontWeight="Bold"/>
                          <TextBlock x:Name="ContinueTitle" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                          <TextBlock x:Name="ContinueArtist" Foreground="#C0BCC7" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                          <TextBlock x:Name="ContinueContext" Foreground="#817D89" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="ContinueButton" Grid.Column="2" Content="Resume" Background="#9D7BFF" Foreground="#17121F" Padding="18,7" Click="Continue_Click"/>
                      </Grid>
                    </Border>

                    <StackPanel x:Name="MoodArea" Margin="0,0,0,18" Visibility="Collapsed">
                      <TextBlock Text="Pick a mood" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                      <ItemsControl x:Name="MoodChips">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Background="#222128" Margin="0,0,7,7" Padding="13,6" Click="Mood_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="HomeLoading" Margin="0,30,0,30" Visibility="Collapsed">
                      <TextBlock Text="Finding something good…" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="Loading fresh releases and recommendations." Foreground="{StaticResource TextMuted}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="HomeError" Margin="0,30,0,35" Visibility="Collapsed">
                      <TextBlock x:Name="HomeErrorText" Text="Home couldn’t refresh" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <Button Content="Try again" HorizontalAlignment="Center" Margin="0,12,0,0" Click="RefreshHome_Click"/>
                    </StackPanel>

                    <ItemsControl x:Name="HomeSections">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,0,0,25">
                          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="HomeShelf_MouseWheel">
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Width="154" Margin="0,0,11,0" Padding="8" Background="#18181D" CornerRadius="13" Cursor="Hand" MouseLeftButtonUp="DiscoveryCard_Click">
                                  <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="138"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border Background="#292830" CornerRadius="9"><Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/></Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,9,2,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Foreground="#8E8A96" FontSize="9" TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                      <Button Content="{Binding PrimaryAction}" Padding="12,5" Click="DiscoveryPrimary_Click"/>
                                      <Button x:Name="AddDiscoveryButton" Content="+" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="4,0,0,0" ToolTip="Add to queue" Click="AddDiscovery_Click" Visibility="Collapsed"/>
                                      <Button x:Name="FavoriteDiscoveryButton" DataContext="{Binding Track}" Style="{StaticResource FavoriteButton}" Width="28" Height="28" Margin="2,0,0,0" Click="FavoriteTrack_Click" Visibility="Collapsed"/>
                                      <Button x:Name="RemoveHistoryButton" Content="×" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Remove from recently played" Click="RemoveRecent_Click" Visibility="Collapsed"/>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="song"><Setter TargetName="AddDiscoveryButton" Property="Visibility" Value="Visible"/><Setter TargetName="FavoriteDiscoveryButton" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding CanRemoveFromHistory}" Value="True"><Setter TargetName="RemoveHistoryButton" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
                              </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </StackPanel>
                      </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>

                <Grid x:Name="CollectionPanel" Visibility="Collapsed">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" VerticalAlignment="Top" ToolTip="Back to Home" Click="CollectionBack_Click"/>
                    <Border Grid.Column="1" Width="96" Height="96" CornerRadius="12" Background="#292830"><Image x:Name="CollectionArtwork" Stretch="UniformToFill"/></Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0">
                      <TextBlock x:Name="CollectionTitle" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="CollectionSubtitle" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                      <TextBlock x:Name="CollectionCount" Foreground="#7F7B87" FontSize="9" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                      <Button x:Name="PlayCollectionButton" Content="Play all" Background="#9D7BFF" Foreground="#17121F" Padding="16,6" Click="PlayCollection_Click"/>
                      <Button x:Name="AddCollectionButton" Content="Add all" Background="Transparent" Padding="16,6" Margin="0,5,0,0" Click="AddCollection_Click"/>
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="1">
                    <StackPanel x:Name="CollectionLoading" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="Loading tracks…" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                    <StackPanel x:Name="CollectionEmpty" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="CollectionEmptyText" Text="No songs found" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                    <ListBox x:Name="CollectionTrackList" MouseLeftButtonUp="CollectionTrack_Click">
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Cursor" Value="Hand"/></Style></ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate><DataTemplate>
                        <Grid Height="58" Margin="8,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Number}" Foreground="#777480" FontSize="9" VerticalAlignment="Center"/>
                          <Border Grid.Column="1" Width="38" Height="38" CornerRadius="6" Background="#292830"><Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/></Border>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="9,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="{StaticResource TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#777480" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                          <Button Grid.Column="4" Style="{StaticResource FavoriteButton}" Width="28" Height="28" Click="FavoriteTrack_Click"/>
                          <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="+" Width="28" Height="28" ToolTip="Add to queue" Click="AddCollectionTrack_Click"/>
                        </Grid>
                      </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Grid>
              </Grid>
            </Grid>

            <Grid x:Name="SearchPanel">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Search music" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Find a song, artist, album, or anything that fits the moment." Foreground="{StaticResource TextMuted}" Margin="1,7,0,0"/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,22,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" FontSize="14" KeyDown="SearchBox_KeyDown" ToolTip="Enter a song, artist, album, or mood"/>
                <Button Grid.Column="1" Content="&#xE721;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="15" Width="34" Height="30" Padding="0" Background="#8B6CE8" Margin="10,0,0,0" ToolTip="Search" Click="Search_Click"/>
              </Grid>
              <Grid Grid.Row="2">
                <StackPanel x:Name="SearchEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                  <TextBlock Text="Your results will appear here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Songs are added to the queue without interrupting playback." Foreground="{StaticResource TextMuted}" Margin="0,7,0,0"/>
                </StackPanel>
                <ListBox x:Name="SearchResults" MouseDoubleClick="SearchResults_DoubleClick">
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid Height="70" Margin="10,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="34"/><ColumnDefinition Width="58"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                      <Border Width="50" Height="50" CornerRadius="7" Background="#2C2A32" HorizontalAlignment="Left"><Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/></Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#85828D" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                      <Button Grid.Column="3" Style="{StaticResource FavoriteButton}" Width="30" Height="30" Click="FavoriteTrack_Click"/>
                      <Button Grid.Column="4" Content="Play" Background="Transparent" Padding="8,5" Click="PlayResult_Click"/>
                      <Button Grid.Column="5" Content="Add" Padding="10,5" Click="AddResult_Click"/>
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>

            <Grid x:Name="AiPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Ask Luna" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Describe what you want to hear. Luna can search, build the queue, and organize your library." Foreground="{StaticResource TextMuted}" Margin="1,7,0,18" TextWrapping="Wrap"/>
              </StackPanel>
              <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChatMessages">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border x:Name="Bubble" Background="#232329" BorderBrush="Transparent" BorderThickness="1" CornerRadius="15" Padding="15,11" Margin="2,5" MaxWidth="720" HorizontalAlignment="Left">
                      <StackPanel>
                        <TextBlock x:Name="RoleLabel" Text="{Binding Role}" Foreground="#B8A5EA" FontSize="9" FontWeight="Bold"/>
                        <TextBox x:Name="MessageText" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0" Foreground="{StaticResource TextPrimary}" SelectionBrush="{StaticResource Accent}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                        <Expander x:Name="ResultExpander" IsExpanded="False" Foreground="#C2CEC7" Margin="0,4,0,0">
                          <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/></Style></Expander.Style>
                          <Expander.Header>
                            <StackPanel Margin="3,1,0,1"><TextBlock Text="{Binding Summary}" Foreground="#77C89B" FontFamily="Cascadia Mono,Consolas" FontSize="11"/><TextBlock Text="Show tool output" Foreground="#858D88" FontSize="9" Margin="0,2,0,0"/></StackPanel>
                          </Expander.Header>
                          <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="Wrap" Background="#111512" BorderBrush="#30453B" BorderThickness="1" Padding="10,8" Margin="0,8,0,0" Foreground="#C2CEC7" FontFamily="Cascadia Mono,Consolas" FontSize="11" SelectionBrush="{StaticResource Accent}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                        </Expander>
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Role}" Value="You"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Bubble" Property="Background" Value="#46366D"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Thinking"><Setter TargetName="Bubble" Property="Background" Value="#17171C"/><Setter TargetName="Bubble" Property="BorderBrush" Value="#2B2932"/><Setter TargetName="RoleLabel" Property="Foreground" Value="#8F8B98"/><Setter TargetName="MessageText" Property="Foreground" Value="#B4B0BC"/><Setter TargetName="MessageText" Property="FontStyle" Value="Italic"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Action"><Setter TargetName="Bubble" Property="Background" Value="#1C1924"/><Setter TargetName="Bubble" Property="BorderBrush" Value="#4D3D70"/><Setter TargetName="RoleLabel" Property="Foreground" Value="#BDA8FF"/><Setter TargetName="MessageText" Property="FontFamily" Value="Cascadia Mono,Consolas"/><Setter TargetName="MessageText" Property="FontSize" Value="11"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Result"><Setter TargetName="Bubble" Property="Background" Value="#171C1A"/><Setter TargetName="Bubble" Property="BorderBrush" Value="#30453B"/><Setter TargetName="RoleLabel" Property="Foreground" Value="#77C89B"/><Setter TargetName="MessageText" Property="Visibility" Value="Collapsed"/><Setter TargetName="ResultExpander" Property="Visibility" Value="Visible"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Plan"><Setter TargetName="Bubble" Property="Background" Value="#191B23"/><Setter TargetName="Bubble" Property="BorderBrush" Value="#38405B"/><Setter TargetName="RoleLabel" Property="Foreground" Value="#91A7E5"/><Setter TargetName="MessageText" Property="FontFamily" Value="Cascadia Mono,Consolas"/><Setter TargetName="MessageText" Property="FontSize" Value="11"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Error"><Setter TargetName="Bubble" Property="Background" Value="#26191D"/><Setter TargetName="Bubble" Property="BorderBrush" Value="#6B343F"/><Setter TargetName="RoleLabel" Property="Foreground" Value="#FF8E9F"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Session"><Setter TargetName="Bubble" Property="Background" Value="Transparent"/><Setter TargetName="Bubble" Property="BorderThickness" Value="0"/><Setter TargetName="Bubble" Property="Padding" Value="4,5"/><Setter TargetName="RoleLabel" Property="Visibility" Value="Collapsed"/><Setter TargetName="MessageText" Property="Foreground" Value="#777480"/><Setter TargetName="MessageText" Property="FontSize" Value="10"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Usage"><Setter TargetName="Bubble" Property="Background" Value="Transparent"/><Setter TargetName="Bubble" Property="BorderThickness" Value="0"/><Setter TargetName="Bubble" Property="Padding" Value="4,5"/><Setter TargetName="RoleLabel" Property="Visibility" Value="Collapsed"/><Setter TargetName="MessageText" Property="Foreground" Value="#777480"/><Setter TargetName="MessageText" Property="FontSize" Value="10"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Diagnostic"><Setter TargetName="Bubble" Property="Background" Value="#19191D"/><Setter TargetName="Bubble" Property="BorderBrush" Value="#33323A"/><Setter TargetName="RoleLabel" Property="Foreground" Value="#888590"/><Setter TargetName="MessageText" Property="Foreground" Value="#AAA7B0"/><Setter TargetName="MessageText" Property="FontFamily" Value="Cascadia Mono,Consolas"/><Setter TargetName="MessageText" Property="FontSize" Value="10"/></DataTrigger>
                      <DataTrigger Binding="{Binding Role}" Value="Event"><Setter TargetName="Bubble" Property="Background" Value="#19191D"/><Setter TargetName="Bubble" Property="BorderBrush" Value="#33323A"/><Setter TargetName="MessageText" Property="FontFamily" Value="Cascadia Mono,Consolas"/><Setter TargetName="MessageText" Property="FontSize" Value="10"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="AiBox" AcceptsReturn="False" FontSize="14" KeyDown="AiBox_KeyDown" ToolTip="Tell Luna what you want to hear"/>
                <Button x:Name="AiSendButton" Grid.Column="1" Content="Send" Background="#8B6CE8" Margin="10,0,0,0" Padding="20,7" Click="AiSend_Click"/>
              </Grid>
            </Grid>

            <Grid x:Name="LibraryPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock x:Name="LibraryHeading" Text="Liked songs" FontSize="32" FontWeight="Bold"/>
                <TextBlock x:Name="LibraryDescription" Text="Songs you have saved." Foreground="{StaticResource TextMuted}" Margin="1,7,0,0"/>
              </StackPanel>
              <TabControl x:Name="LibraryTabs" Grid.Row="1" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" TabStripPlacement="Top">
                <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/></ControlTemplate></TabControl.Template>
                <TabItem Header="Liked songs">
                  <Grid>
                  <StackPanel x:Name="FavoritesEmpty" VerticalAlignment="Center" Margin="0,0,0,60"><TextBlock Text="No liked songs yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Use the heart beside any song to keep it here." Foreground="{StaticResource TextMuted}" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
                  <ListBox x:Name="FavoritesList" Margin="0,12,0,0">
                    <ListBox.ItemTemplate><DataTemplate><Grid Height="62" Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="7" Background="#2C2A32"><Image Source="{Binding Track.ArtworkUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Track.Artist}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FolderPath}" Foreground="#777580" FontSize="9"/></StackPanel><Button Grid.Column="2" Content="Add" Margin="4" Click="AddFavorite_Click"/><Button Grid.Column="3" Content="Remove" Background="Transparent" Margin="4" Click="Unfavorite_Click"/></Grid></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  </Grid>
                </TabItem>
                <TabItem Header="Saved queues">
                  <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Button Content="Import link" HorizontalAlignment="Right" Background="Transparent" Padding="12,5" Margin="0,0,5,4" Click="ImportPlaylist_Click"/>
                  <StackPanel x:Name="SavedQueuesEmpty" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,60"><TextBlock Text="No saved queues yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Save a queue or import an InnerTune playlist link." Foreground="{StaticResource TextMuted}" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
                  <ListBox x:Name="SavedQueueList" Grid.Row="1" Margin="0,6,0,0">
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid Margin="5,3">
                        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Background="#19191E" CornerRadius="12"/>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                          <ToggleButton x:Name="SavedQueueToggle" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" Cursor="Hand">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                              <Border x:Name="QueueHeader" Background="Transparent" CornerRadius="12" Padding="9,0">
                                <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                  <Border Width="40" Height="40" CornerRadius="8" Background="#302A42" HorizontalAlignment="Left"><Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/></Border>
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0"><TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Tracks.Count, StringFormat={}{0} songs}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"/></StackPanel>
                                  <TextBlock x:Name="QueueChevron" Grid.Column="2" Text="›" FontSize="20" Foreground="#9B96A4" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform></TextBlock>
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QueueHeader" Property="Background" Value="#232229"/></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="QueueHeader" Property="Background" Value="#25222D"/><Setter TargetName="QueueChevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                            </ToggleButton.Template>
                          </ToggleButton>
                          <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE768;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="#C9B5FF" ToolTip="Load queue" AutomationProperties.Name="Load queue" Click="LoadSaved_Click"/>
                          <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE71B;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="#B8B4C0" ToolTip="Copy playlist link" AutomationProperties.Name="Copy playlist link" Click="ShareSaved_Click"/>
                          <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="#A9A5B1" ToolTip="Delete queue" AutomationProperties.Name="Delete queue" Click="DeleteSaved_Click"/>
                        </Grid>
                        <Border x:Name="SavedQueueSongs" Grid.Row="1" Visibility="Collapsed" Margin="12,2,12,8" Padding="7" Background="#141419" CornerRadius="0,0,11,11">
                          <ListBox ItemsSource="{Binding Tracks}" MaxHeight="360" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate>
                              <Border Height="48" Padding="6,0" CornerRadius="7" Cursor="Hand" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" MouseLeftButtonUp="SavedTrack_Click">
                                <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                  <Border Width="34" Height="34" CornerRadius="5" Background="#292830" HorizontalAlignment="Left"><Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/></Border>
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0"><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" FontSize="9" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel>
                                  <Button Grid.Column="2" Style="{StaticResource FavoriteButton}" Width="28" Height="28" Click="FavoriteTrack_Click"/>
                                  <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#85818D" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                          </ListBox>
                        </Border>
                      </Grid>
                      <DataTemplate.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=SavedQueueToggle}" Value="True"><Setter TargetName="SavedQueueSongs" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  </Grid>
                </TabItem>
              </TabControl>
            </Grid>
          </Grid>

          <Grid x:Name="VideoPanel" Visibility="Collapsed" Panel.ZIndex="20" Margin="20" Background="#0D0D11">
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
            <Grid Margin="16,0">
              <StackPanel VerticalAlignment="Center"><TextBlock x:Name="VideoTitle" Text="Video" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="VideoMeta" Text="Loading…" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Change" Height="28" Padding="12,0" Background="#24232B" Margin="0,0,6,0" ToolTip="Choose another video" Click="ChangeVideo_Click"/>
                <Button Style="{StaticResource IconButton}" Content="×" ToolTip="Close video" Click="CloseVideo_Click"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="12,0" Background="Black" CornerRadius="14" ClipToBounds="True">
              <Grid>
                <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" MediaFailed="VideoPlayer_MediaFailed"/>
                <StackPanel x:Name="VideoLoading" VerticalAlignment="Center"><TextBlock Text="Loading video…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="This may take a moment the first time." Foreground="#8F8B97" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
              </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="Use the player controls below to pause or seek." Foreground="#777480" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>

          <Grid x:Name="VideoChooserPanel" Visibility="Collapsed" Panel.ZIndex="30" Margin="20" Background="#0D0D11">
            <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
            <Grid Margin="18,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Choose a video" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="VideoChooserSubtitle" Text="Finding the best match…" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Style="{StaticResource IconButton}" Content="×" HorizontalAlignment="Right" ToolTip="Close" Click="CloseVideoChooser_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="18,0,18,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="VideoSearchBox" Height="34" Padding="13,7" KeyDown="VideoSearchBox_KeyDown" ToolTip="Search YouTube for another video"/>
              <Button Grid.Column="1" Content="&#xE721;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Width="34" Height="30" Padding="0" Background="#8B6CE8" Margin="8,0,0,0" ToolTip="Search videos" Click="VideoSearch_Click"/>
            </Grid>
            <Grid Grid.Row="2" Margin="12,0,12,0">
              <StackPanel x:Name="VideoChooserLoading" VerticalAlignment="Center">
                <TextBlock Text="Finding real videos…" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Checking official videos, duration, and artist match." HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel x:Name="VideoChooserEmpty" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="No convincing video found" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Try a different search, or keep listening with album artwork and lyrics." HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,0"/>
              </StackPanel>
              <ListBox x:Name="VideoCandidateList" Visibility="Collapsed" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid Height="78" Margin="6,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                    <Border Width="108" Height="61" CornerRadius="7" Background="#292830" HorizontalAlignment="Left" ClipToBounds="True"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,10,0">
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Author}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                      <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding MatchLabel}" Foreground="#BFAAFF" FontSize="8" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DurationText}" Foreground="#817E89" FontSize="8" Margin="9,0,0,0"/>
                        <TextBlock Text="{Binding PlaybackLabel}" Foreground="#817E89" FontSize="8" Margin="9,0,0,0"/>
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Use" Height="28" Padding="13,0" Click="UseVideoCandidate_Click"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <TextBlock Grid.Row="3" Text="Your choice is remembered for this song. Change it any time from the video player." Foreground="#777480" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Grid>

        <Border Grid.Column="2" Background="#111115" BorderBrush="#242329" BorderThickness="1,0,0,0" Padding="18,16,18,16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#19191E" CornerRadius="16" Padding="3" HorizontalAlignment="Left" Margin="2,0,0,16">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="QueueViewButton" Content="Queue" Height="29" Padding="15,0" Background="#393247" Click="QueueView_Click"/>
                <Button x:Name="LyricsViewButton" Content="Lyrics" Height="29" Padding="15,0" Background="Transparent" Click="LyricsView_Click"/>
              </StackPanel>
            </Border>

            <Grid x:Name="QueuePanel" Grid.Row="1">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="2,0,2,15">
                <StackPanel><TextBlock Text="Up next" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="QueueCountText" Text="0 songs" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                <StackPanel x:Name="QueueActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="SaveQueueButton" Content="Save" Padding="12,5" Margin="0,0,5,0" Click="SaveQueue_Click"/>
                  <Button x:Name="ShareQueueButton" Content="Share" Background="Transparent" Padding="10,5" Margin="0,0,3,0" Click="ShareQueue_Click"/>
                  <Button x:Name="ClearQueueButton" Content="Clear" Background="Transparent" Padding="10,5" Click="ClearQueue_Click"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1">
                <StackPanel x:Name="QueueEmpty" VerticalAlignment="Center" Margin="16,0,16,60">
                  <TextBlock Text="Nothing queued" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Search for songs or ask Luna to build something for you." Foreground="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18"/>
                  <Button Content="Find music" Background="#8B6CE8" HorizontalAlignment="Center" Click="EmptySearch_Click"/>
                </StackPanel>
                <ListBox x:Name="QueueList" MouseDoubleClick="QueueList_DoubleClick">
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid Height="62" Margin="7,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                      <Border Width="40" Height="40" CornerRadius="6" Background="#2C2A32" HorizontalAlignment="Left"><Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/></Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,7,0"><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" FontSize="9" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource FavoriteButton}" Width="30" Height="30" Click="FavoriteTrack_Click"/>
                      <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" Content="×" ToolTip="Remove" Click="RemoveQueue_Click"/>
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>

            <Grid x:Name="LyricsPanel" Grid.Row="1" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="2,0,2,14">
                <StackPanel>
                  <TextBlock Text="Lyrics" FontSize="21" FontWeight="Bold"/>
                  <TextBlock x:Name="LyricsMeta" Text="Play a song to see its lyrics" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,38,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="RefreshLyricsButton" Style="{StaticResource IconButton}" Content="&#xE72C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Find lyrics again" Click="RefreshLyrics_Click"/>
              </Grid>
              <Grid Grid.Row="1">
                <StackPanel x:Name="LyricsLoading" VerticalAlignment="Center" Visibility="Collapsed" Margin="16,0,16,50">
                  <TextBlock Text="Finding lyrics…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="This only happens once per song." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="LyricsEmpty" VerticalAlignment="Center" Margin="16,0,16,50">
                  <TextBlock x:Name="LyricsEmptyTitle" Text="Nothing playing" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="LyricsEmptyDetail" Text="Choose a song, then come back here." Foreground="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16"/>
                  <Button x:Name="RetryLyricsButton" Content="Try again" HorizontalAlignment="Center" Visibility="Collapsed" Click="RefreshLyrics_Click"/>
                </StackPanel>
                <ListBox x:Name="LyricsList" Visibility="Collapsed" PreviewMouseLeftButtonUp="LyricsLine_Click" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate>
                    <TextBlock x:Name="LyricText" Text="{Binding Text}" Foreground="#85818E" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="22" Margin="8,8,12,8" Opacity="0.72"/>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="LyricText" Property="Foreground" Value="#F4EFFF"/><Setter TargetName="LyricText" Property="FontSize" Value="17"/><Setter TargetName="LyricText" Property="FontWeight" Value="Bold"/><Setter TargetName="LyricText" Property="Opacity" Value="1"/></DataTrigger></DataTemplate.Triggers>
                  </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              <Grid Grid.Row="2" Margin="8,10,8,0">
                <TextBlock x:Name="LyricsHint" Text="Click a line to seek" Foreground="#777480" FontSize="9"/>
                <TextBlock Text="LRCLIB" HorizontalAlignment="Right" Foreground="#777480" FontSize="9" ToolTip="Lyrics supplied by LRCLIB"/>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="#17171C" BorderBrush="#2A2931" BorderThickness="0,1,0,0" Margin="1,0,1,1">
        <Grid x:Name="PlayerBar" Background="Transparent" PreviewMouseLeftButtonDown="PlayerBar_MouseLeftButtonDown">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="NowPlayingColumn" Width="2.2*"/><ColumnDefinition x:Name="TransportColumn" Width="3*"/><ColumnDefinition x:Name="UtilityColumn" Width="2.2*"/></Grid.ColumnDefinitions>
          <Grid x:Name="NowPlayingSection" Margin="18,10" Background="Transparent" Cursor="Hand" MouseEnter="NowPlayingSection_MouseEnter" MouseLeave="NowPlayingSection_MouseLeave">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="ArtworkFrame" Width="58" Height="58" CornerRadius="9" Background="#292830"><Image x:Name="NowArtwork" Stretch="UniformToFill"/></Border>
            <StackPanel x:Name="NowTextPanel" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0"><TextBlock x:Name="NowTitle" Text="Nothing playing" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="Choose a song from the queue" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
            <Popup x:Name="MiniQueuePopup" PlacementTarget="{Binding ElementName=NowPlayingSection}" Placement="Top" VerticalOffset="-7" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True" Focusable="False">
              <Border x:Name="MiniQueueSurface" Width="380" MaxHeight="420" Margin="0,0,0,2" Padding="9,10,9,8" Background="#17171C" BorderBrush="#3B3944" BorderThickness="1" CornerRadius="12" MouseEnter="MiniQueueSurface_MouseEnter" MouseLeave="MiniQueueSurface_MouseLeave">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Margin="8,1,8,8"><TextBlock Text="Queue" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="MiniQueueCount" HorizontalAlignment="Right" Foreground="#898691" FontSize="9" VerticalAlignment="Center"/></Grid>
                  <ListBox x:Name="MiniQueueList" Grid.Row="1" MaxHeight="360" PreviewMouseLeftButtonUp="MiniQueueList_Click">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Cursor" Value="Hand"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid Height="42" Margin="7,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Number}" Foreground="#777480" FontSize="9" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="5" Background="#292830" HorizontalAlignment="Left"><Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,8,0"><TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="#96939E" FontSize="8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#777480" FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Popup>
          </Grid>
          <Grid x:Name="TransportSection" Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="24"/></Grid.RowDefinitions><StackPanel x:Name="TransportButtons" Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="#8F8B97" ToolTip="Shuffle off" Click="Shuffle_Click"/><Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#xE892;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="#C9C6D1" ToolTip="Previous" Click="Previous_Click"/><Button x:Name="PlayButton" Width="44" Height="44" Padding="0" Background="#9D7BFF" Foreground="#15111C" ToolTip="Play or pause" Click="PlayPause_Click"><TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform x:Name="PlayGlyphRotation"/></TextBlock.RenderTransform></TextBlock></Button><Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="#C9C6D1" ToolTip="Next" Click="Next_Click"/><Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="&#xE8EE;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="#8F8B97" ToolTip="Repeat off" Click="Repeat_Click"/></StackPanel><Grid x:Name="SeekSection" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PositionColumn" Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DurationColumn" Width="38"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionText" Text="0:00" Foreground="#918E99" FontSize="9" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Style="{StaticResource ThemedSlider}" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" PreviewMouseUp="SeekSlider_MouseUp"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="#918E99" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Grid>
          <Grid x:Name="UtilitySection" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0">
            <Grid.RowDefinitions><RowDefinition x:Name="UtilityTopRow" Height="*"/><RowDefinition x:Name="UtilityBottomRow" Height="0"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="UtilityVolumeGlyphColumn" Width="Auto"/><ColumnDefinition x:Name="UtilityVolumeColumn" Width="Auto"/><ColumnDefinition x:Name="UtilityVideoColumn" Width="Auto"/><ColumnDefinition x:Name="UtilityExpandColumn" Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="VolumeGlyph" Text="&#xE767;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Foreground="#A9A5B1" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Volume"/>
            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}" Width="86" Minimum="0" Maximum="100" Value="72" ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume"/>
            <Button x:Name="WatchVideoButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE714;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Margin="8,0,0,0" ToolTip="Watch video" Click="WatchVideo_Click"/>
            <Button x:Name="ExpandButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="▱" Margin="2,0,0,0" ToolTip="Mini player" Click="Mini_Click"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
